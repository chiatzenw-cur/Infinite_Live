# ---- video generation provider ----
# provider: mock | wan | seedance | kling | fastwan | deepinfra
# deepinfra = recommended: FastWan-QAD-FP8, ~2.4s runtime, $0.0125/clip, silent 5s/480p
VIDEO_PROVIDER=deepinfra
VIDEO_RESOLUTION=720P
VIDEO_RATIO=16:9
VIDEO_AUDIO=1
# --- DeepInfra (FastWan-QAD-FP8-1.3B) --- synchronous, silent 5s/480p clips
DEEP_INFRA_API=
DEEPINFRA_RESOLUTION=480p
DEEPINFRA_ORIENTATION=landscape
CLIP_SECONDS=5
# Volcano Engine (Seedance) key. config also accepts VIDEO_API_KEY / ARK_API_KEY aliases.
VOLCANO_API=
SEEDANCE_MODEL=doubao-seedance-2-0-fast-260128
# need to activate the model first in the ARK console (see README).

# --- self-hosted FastWan (rented GPU, scripts/fastwan_server.py) ---
# provider=fastwan + FASTWAN_URL points at the GPU box.
FASTWAN_URL=http://127.0.0.1:8000

# simulate provider latency for offline demos (seconds)
VIDEO_MOCK_LATENCY=4

# ---- beat / loop ----
# continuous mode: BEAT_SECONDS is the VOTE-refresh cadence for the story; clips are CLIP_SECONDS
BEAT_SECONDS=15
CLIP_SECONDS=5
LOOKAHEAD=1
WORK_DIR=assets

# ---- reading the room (danmaku) ----
# danmaku_mode: mock | selfhosted | openlive
BILI_DANMAKU_MODE=mock
BILI_ROOM_ID=
# Open Live platform (production, needs 入驻审核):
BILI_OPEN_APP_ID=
BILI_OPEN_SECRET=
# optional cookie for getDanmuInfo (self-hosted reader): BILI_COOKIE=
BILI_COOKIE=

# ---- pushing the stream ----
# rtmp://live-push.bilivideo.com/live/<stream-key>  (set both parts)
BILI_PUSH_URL=
BILI_STREAM_KEY=
# fallback: write a local file instead of pushing
OUTPUT_PATH=

# ---- llm (danmaku -> prompt); leave blank to use the rule-based story drafts ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
